                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.token) { pm.collectionVariables.set('token', res.data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"أحمد محمود\",\n  \"username\": \"ahmed_new\",\n  \"email\": \"ahmed.new@gmail.com\",\n  \"password\": \"SecurePass123\",\n  \"phone\": \"01012345678\",\n  \"role\": \"customer\"\n}"
