{
  "info": {
    "name": "Arab Aura - Mobile & Web REST API",
    "_postman_id": "arab-aura-api-v1",
    "description": "Arab Aura Egyptian Fashion Marketplace & Micro-Hub Logistics Cloud API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://arab-aura.vercel.app/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. System Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register New Account",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"أحمد محمود\",\n  \"email\": \"ahmed.test@example.com\",\n  \"password\": \"123456\",\n  \"phone\": \"01012345678\",\n  \"role\": \"customer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@arabaura.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Register FCM Device Token (Mobile Push)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceToken\": \"fcm_token_sample_abc123\",\n  \"deviceType\": \"android\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/device-token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "device-token"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Products Catalog",
      "item": [
        {
          "name": "Get Products (With Filters & Pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=20&category=all",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "category", "value": "all" },
                { "key": "search", "value": "بولو", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Product Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/6aea72b2998c0bf001694c85",
              "host": ["{{baseUrl}}"],
              "path": ["products", "6aea72b2998c0bf001694c85"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Orders & Doorstep OTP",
      "item": [
        {
          "name": "Create Order (Flat 35 EGP Neighborhood Shipping)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}", "disabled": true }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"محمد علي\",\n  \"customerPhone\": \"01123456789\",\n  \"neighborhood\": \"الحي المتميز\",\n  \"city\": \"6 أكتوبر\",\n  \"shippingAddress\": \"عمارة 14 - شارع النصر\",\n  \"items\": [\n    {\n      \"product\": \"6aea72b2998c0bf001694c85\",\n      \"title\": \"تيشيرت بولو قطن مصري فاخر\",\n      \"price\": 490,\n      \"quantity\": 1,\n      \"size\": \"L\",\n      \"color\": \"أبيض ناصع\"\n    }\n  ],\n  \"paymentMethod\": \"cod\",\n  \"notes\": \"برجاء الاتصال قبل الوصول\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Get Customer Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/my-orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "my-orders"]
            }
          }
        },
        {
          "name": "Verify Doorstep Handover OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/:orderId/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["orders", ":orderId", "verify-otp"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Driver & Delivery Tracking",
      "item": [
        {
          "name": "Get Driver Deliveries",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/driver/deliveries",
              "host": ["{{baseUrl}}"],
              "path": ["driver", "deliveries"]
            }
          }
        },
        {
          "name": "Update Driver GPS Location",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 29.9765,\n  \"lng\": 30.9421\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/driver/location",
              "host": ["{{baseUrl}}"],
              "path": ["driver", "location"]
            }
          }
        }
      ]
    },
    {
      "name": "5. AI Fashion Insights",
      "item": [
        {
          "name": "Product AI Quality & Pricing Insights",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"men_tshirts\",\n  \"material\": \"قطن مصري 100%\",\n  \"price\": 490\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/product-insights",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "product-insights"]
            }
          }
        }
      ]
    }
  ]
}
